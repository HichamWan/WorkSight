# Copy this file to .env and change the passwords.
# .env is git-ignored. Never commit real passwords.

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=worksight
MYSQL_USER=worksight_app
MYSQL_PASSWORD=change-me-app

# Host port for MySQL. 3306 is often already in use on Windows (local MySQL,
# XAMPP, another container), so the default here is 3307.
DB_HOST_PORT=3307

# Used by the Python code (SQLAlchemy). Host-side connection string.
DATABASE_URL=mysql+pymysql://worksight_app:change-me-app@127.0.0.1:3307/worksight
