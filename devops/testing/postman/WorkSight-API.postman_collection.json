{
  "info": {
    "name": "WorkSight API",
    "description": "Built from Hicham's WorkSight_API_Contract.md (Week 2). Covers every endpoint in section 16 of the contract, grouped to match the doc's own sections.\n\nAuth note: the contract doesn't explicitly document the Authorization header format for non-login requests -- this collection assumes `Authorization: Bearer <access_token>`, auto-captured from the Login responses into {{admin_token}} / {{hr_token}}. Confirm this with Hicham and adjust if the real backend expects something different.\n\nRun 'Login (Super Admin)' and 'Login (HR/Manager/Executive)' first -- their test scripts save the tokens for every other request in this collection automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Admin Auth",
      "item": [
        {
          "name": "Login (Super Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{API_BASE_URL}}/admin/auth/login",
              "host": [
                "{{API_BASE_URL}}"
              ],
              "path": [
                "admin",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Login succeeded', function () { pm.expect(pm.response.json().success).to.eql(true); });",
                  "pm.test('Access token present', function () { pm.expect(pm.response.json()).to.have.property('access_token'); });",
                  "if (pm.response.code === 200) { pm.environment.set('admin_token', pm.response.json().access_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout (Super Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{API_BASE_URL}}/admin/auth/logout",
              "host": [
                "{{API_BASE_URL}}"
              ],
              "path": [
                "admin",
                "auth",
                "logout"
              ]
            }
          },
          "event": [
            {
